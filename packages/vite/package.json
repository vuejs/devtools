{
  "name": "vite-plugin-vue-devtools",
  "version": "9.0.0-beta.0",
  "description": "A Vite plugin for Vue DevTools",
  "keywords": [
    "dx",
    "vite-plugin",
    "vite-plugin-vue-devtools",
    "vue-devtools"
  ],
  "homepage": "https://github.com/vuejs/devtools#readme",
  "bugs": {
    "url": "https://github.com/vuejs/devtools/issues"
  },
  "license": "MIT",
  "author": "webfansplz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuejs/devtools.git",
    "directory": "packages/vite"
  },
  "files": [
    "client",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && node --input-type=commonjs -e \"const fs=require('node:fs');fs.rmSync('client',{recursive:true,force:true});fs.cpSync('../client/dist','client',{recursive:true})\"",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@vitejs/devtools-kit": "catalog:",
    "@vue/devtools-kit": "workspace:*"
  },
  "devDependencies": {
    "@vue/devtools-client": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@vitejs/devtools": "^0.7.5",
    "vite": "^8.3.0"
  }
}
