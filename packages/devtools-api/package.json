{
  "name": "@vue/devtools-api",
  "version": "9.0.0-beta.1",
  "description": "Public plugin API for Vue DevTools",
  "license": "MIT",
  "author": "webfansplz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuejs/devtools.git",
    "directory": "packages/devtools-api"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index-node.d.mts",
        "default": "./dist/index-node.mjs"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@vue/devtools-kit": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
